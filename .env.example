# Simu-Emperor Server Environment (No LLM API keys hosted on game server)
PORT=8787
DATABASE_PATH=./data/runtime/ming-gameplay.db

# Role tokens for local trial
MONARCH_TOKEN=monarch-token
MONARCH_DEBUG_TOKEN=monarch-debug-token
AGENT_HOST_TOKEN=agent-host-token

# Debug truth switch (requires BOTH ENABLE_DEBUG_TRUTH=1 and MONARCH_DEBUG_TOKEN)
ENABLE_DEBUG_TRUTH=0
