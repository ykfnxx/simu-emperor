      "css": ".ds-chat-input{font-family:var(--font,CourtSans,\"PingFang SC\",sans-serif);width:300px;min-height:44px;max-height:92px;resize:none;background:rgba(255,255,255,.58);border:1px solid rgba(120,95,45,.36);border-radius:10px;padding:9px 12px;font-size:13.5px;line-height:1.55;color:#33291a;caret-color:#8a6a20}.ds-chat-input::placeholder{color:var(--paper-muted,#6d5d3d)}.ds-chat-input:focus-visible{outline:2px solid var(--bright,#f2d58a);outline-offset:2px;}"
    },
    {
