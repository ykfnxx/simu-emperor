  "components": [
    {
      "name": "朱红主操作",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "截奏、下发和明确的主要操作；预览保留渐变、阴影、hover、focus 与 disabled。",
      "html": "<button type=\"button\" class=\"ds-primary\">截奏</button>",
      "css": ".ds-primary{font-family:var(--font,CourtSans,\"PingFang SC\",sans-serif);border:1px solid rgba(208,170,90,.65);border-radius:9px;background:linear-gradient(180deg,var(--action-top,#a6382a),var(--action-bottom,#8e2b21));color:#fdf0d6;padding:7px 18px;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(60,14,8,.35),inset 0 1px 0 rgba(255,255,255,.14);cursor:pointer;transition:filter 150ms ease}.ds-primary:hover:not(:disabled){filter:brightness(1.1)}.ds-primary:focus-visible{outline:2px solid var(--bright,#f2d58a);outline-offset:2px;}.ds-primary:disabled{opacity:.58;filter:saturate(.55);cursor:default}"
    },
    {
      "name": "深蓝次操作",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "深蓝省份或全国面板中的次要操作。",
      "html": "<button type=\"button\" class=\"ds-secondary\">阅方略</button>",
      "css": ".ds-secondary{font-family:var(--font,CourtSans,\"PingFang SC\",sans-serif);border:1px solid var(--line,rgba(208,170,90,.26));border-radius:8px;padding:6px 12px;font-size:12.5px;color:var(--text,#f4ead6);background:rgba(208,170,90,.08);cursor:pointer;transition:background 150ms ease,border-color 150ms ease,color 150ms ease}.ds-secondary:hover:not(:disabled){border-color:var(--brass,#d0aa5a);background:rgba(208,170,90,.16);color:var(--bright,#f2d58a)}.ds-secondary:focus-visible{outline:2px solid var(--bright,#f2d58a);outline-offset:2px;}.ds-secondary:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "纸面工具按钮",
      "kind": "button",
      "refersTo": "button-paper",
      "description": "中央纸面会话的刷新、新议与成员工具按钮。",
      "html": "<button type=\"button\" class=\"ds-paper-button\">刷新</button>",
      "css": ".ds-paper-button{font-family:var(--font,CourtSans,\"PingFang SC\",sans-serif);border:1px solid rgba(120,95,45,.35);border-radius:8px;padding:5px 10px;font-size:12px;color:#5c4b2c;background:rgba(255,255,255,.38);cursor:pointer}.ds-paper-button:hover:not(:disabled){background:rgba(208,170,90,.25);color:#33291a;border-color:rgba(140,110,55,.6)}.ds-paper-button:focus-visible{outline:2px solid var(--bright,#f2d58a);outline-offset:2px;}.ds-paper-button:disabled{opacity:.45;cursor:default}"
    },
    {
